# HitStor Server Environment Variables
#
# Copy this file to /etc/hitstor/server.env and edit as needed.
# The systemd service loads this file automatically.

# Repository passwords are managed via the dashboard.
# For legacy single-repo mode, set HITSTOR_PASSWORD here.
# HITSTOR_PASSWORD=

# Repository location (for legacy single-repo mode). Overrides config file.
# HITSTOR_REPO=/var/lib/hitstor/repo
