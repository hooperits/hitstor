# Copy to .env and edit before starting the quickstart stack:
#   cp .env.example .env

# Required — encrypts the backup repository (remember this password).
HITSTOR_PASSWORD=change-me-to-a-strong-password

# Optional — protect the web dashboard (http://localhost:8421).
# HITSTOR_DASHBOARD_PASSWORD=change-me

# Image tag (use "latest" or a release version).
HITSTOR_VERSION=latest

# Override image registry if not using GHCR:
# HITSTOR_IMAGE=hitstor

# Host ports (change if 8420/8421 are already in use).
# HITSTOR_GRPC_PORT=8420
# HITSTOR_DASHBOARD_PORT=8421

# Set to "false" to skip automatic "hitstor init" on first start.
# HITSTOR_AUTO_INIT=true