#!/bin/sh
set -e

HITSTOR_VERSION="__VERSION__"

# __INLINE_COMMON__
# __INLINE_WIZARD_AGENT__
# __INLINE_VERIFY__
# __INLINE_UNINSTALL__
# __INLINE_UPGRADE__

# ---- Main Agent Installer ----

main_agent() {
    parse_flags "$@"

    # Handle --version.
    if [ "$FLAG_VERSION" -eq 1 ]; then
        echo "HitStor Agent Installer v${HITSTOR_VERSION}"
        exit 0
    fi

    # Handle --help.
    if [ "$FLAG_HELP" -eq 1 ]; then
        show_help "Agent"
        exit 0
    fi

    banner "Agent"
    check_root
    check_linux
    check_systemd

    # Handle --uninstall (no payload extraction needed).
    if [ "$FLAG_UNINSTALL" -eq 1 ]; then
        uninstall_agent
        exit 0
    fi

    # Extract payload.
    extract_payload

    # Detect existing installation → upgrade path.
    if [ -f /usr/bin/hitstor-agent ]; then
        upgrade_agent
        exit 0
    fi

    # Fresh install: wizard or --no-wizard.
    if [ "$FLAG_NO_WIZARD" -eq 1 ]; then
        nowizard_agent
    else
        wizard_agent
    fi

    install_agent_files

    # Verify.
    if wait_and_verify_agent; then
        print_agent_success
    else
        echo ""
        color_print yellow "Installation completed with warnings."
        color_print yellow "The service may still be starting. Check with:"
        echo "  sudo systemctl status hitstor-agent"
        echo "  sudo journalctl -u hitstor-agent -f"
        echo ""
    fi
}

main_agent "$@"

exit 0
__PAYLOAD_BELOW__
