# HitStor Agent Environment Variables
#
# Copy this file to /etc/hitstor/agent.env and edit as needed.
# The systemd service loads this file automatically.

# Agent listen port for dashboard management (default: 8422).
# The server connects to this port to register and configure the agent.
HITSTOR_AGENT_LISTEN_PORT=8422

# Remote server address (required for legacy/manual setup, leave empty for
# dashboard-managed agents — the server sends this during registration).
#HITSTOR_AGENT_SERVER=backup-server.internal:8420

# Agent API key (required for legacy/manual setup, leave empty for
# dashboard-managed agents — the server sends this during registration).
#HITSTOR_AGENT_API_KEY=your-api-key-here
